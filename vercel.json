{
  "version": 2,
  "builds": [
    {
      "src": "ui/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/docs",
      "dest": "/ui/docs.html"
    },
    {
      "src": "/openapi.json",
      "dest": "/ui/openapi.json"
    },
    {
      "src": "/(.*)",
      "dest": "/ui/$1"
    }
  ]
}
